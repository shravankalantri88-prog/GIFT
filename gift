
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gift Recipient Manager</title>

  <style>
    :root {
      --primary: #234b3b;
      --primary-light: #e9f1eb;
      --gold: #c29b55;
      --background: #f6f7f4;
      --white: #ffffff;
      --text: #24332c;
      --muted: #78827c;
      --border: #e0e6e0;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--background);
      color: var(--text);
    }

    header {
      background: var(--primary);
      color: white;
      padding: 32px 6%;
      border-bottom: 4px solid var(--gold);
    }

    .header-content {
      max-width: 1400px;
      margin: auto;
    }

    .eyebrow {
      color: #d9c69f;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(27px, 4vw, 38px);
      margin: 12px 0 8px;
    }

    header p {
      color: #e0e9e2;
      margin: 0;
      line-height: 1.6;
    }

    main {
      max-width: 1400px;
      margin: 28px auto;
      padding: 0 24px 40px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: var(--white);
      padding: 20px;
      border: 1px solid var(--border);
      border-radius: 12px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 13px;
    }

    .stat-number {
      font-size: 30px;
      font-weight: bold;
      margin-top: 8px;
      color: var(--primary);
    }

    .toolbar {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      align-items: center;
      background: white;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 12px 12px 0 0;
    }

    .toolbar input,
    .toolbar select {
      flex: 1;
      min-width: 180px;
    }

    input, select {
      width: 100%;
      min-width: 0;
      padding: 11px 12px;
      font-size: 14px;
      border: 1px solid #d7ded8;
      border-radius: 7px;
      background: white;
      color: var(--text);
      font-family: inherit;
    }

    input:focus, select:focus {
      outline: 2px solid #9bbba6;
      border-color: var(--primary);
    }

    button {
      cursor: pointer;
      border: none;
      border-radius: 7px;
      padding: 12px 16px;
      font-size: 13px;
      font-weight: bold;
      font-family: inherit;
      transition: opacity 0.2s;
    }

    button:hover {
      opacity: 0.85;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-secondary {
      background: var(--primary-light);
      color: var(--primary);
    }

    .btn-danger {
      background: #fff0ee;
      color: #a53c30;
    }

    .table-wrap {
      overflow-x: auto;
      background: white;
      border: 1px solid var(--border);
      border-top: none;
      border-radius: 0 0 12px 12px;
    }

    table {
      width: 100%;
      min-width: 850px;
      border-collapse: collapse;
    }

    th {
      background: #f0f4ef;
      color: var(--primary);
      font-size: 12px;
      text-align: left;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 15px 12px;
      white-space: nowrap;
    }

    td {
      padding: 10px 8px;
      border-top: 1px solid #edf0ec;
      vertical-align: middle;
    }

    tbody tr:hover {
      background: #fafbf9;
    }

    td:first-child {
      text-align: center;
      font-weight: bold;
      color: var(--muted);
      width: 55px;
    }

    td input, td select {
      min-width: 120px;
    }

    td .address-input {
      min-width: 190px;
    }

    .gift-select {
      min-width: 135px;
    }

    .bottom-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    .save-status {
      color: var(--muted);
      font-size: 13px;
    }

    .instructions {
      background: #edf3ee;
      border-radius: 10px;
      padding: 16px 18px;
      margin-top: 24px;
      font-size: 13px;
      line-height: 1.8;
      color: #43574a;
    }

    .empty-state {
      display: none;
      text-align: center;
      padding: 35px;
      color: var(--muted);
    }

    @media (max-width: 600px) {
      header {
        padding: 26px 20px;
      }

      main {
        padding: 0 12px 28px;
        margin-top: 18px;
      }

      .stats {
        gap: 8px;
      }

      .stat-card {
        padding: 12px;
      }

      .stat-number {
        font-size: 24px;
      }

      .stat-label {
        font-size: 11px;
      }

      .toolbar {
        padding: 12px;
      }

      .toolbar input,
      .toolbar select {
        min-width: 100%;
      }

      .toolbar button {
        flex: 1;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="header-content">
    <div class="eyebrow">Gift Planning</div>
    <h1>Gift Recipient Manager</h1>
    <p>One organised list for all 70 recipients. Enter their details, select a gift and keep everything in one place.</p>
  </div>
</header>

<main>

  <section class="stats">
    <div class="stat-card">
      <div class="stat-label">Total Recipients</div>
      <div class="stat-number" id="totalCount">70</div>
    </div>

    <div class="stat-card">
      <div class="stat-label">Entries Completed</div>
      <div class="stat-number" id="completedCount">0 / 70</div>
    </div>

    <div class="stat-card">
      <div class="stat-label">Gifts Assigned</div>
      <div class="stat-number" id="giftCount">0 / 70</div>
    </div>
  </section>

  <section class="toolbar">
    <input
      type="search"
      id="searchInput"
      placeholder="Search name, address or mobile..."
      aria-label="Search recipients"
    >

    <select id="giftFilter" aria-label="Filter by gift type">
      <option value="all">All gift types</option>
      <option value="Seep">Seep</option>
      <option value="Organizer">Organizer</option>
      <option value="Gajraj">Gajraj</option>
      <option value="unassigned">Gift not selected</option>
    </select>

    <button class="btn-secondary" id="resetFilter">
      Reset filters
    </button>

    <button class="btn-primary" id="exportButton">
      Export CSV
    </button>
  </section>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>No.</th>
          <th>Name</th>
          <th>Address</th>
          <th>Mobile Number</th>
          <th>Type of Gift</th>
        </tr>
      </thead>

      <tbody id="recipientList"></tbody>
    </table>

    <div class="empty-state" id="emptyState">
      No matching recipients found. Try changing your search or filter.
    </div>
  </div>

  <div class="bottom-bar">
    <span class="save-status" id="saveStatus" aria-live="polite">
      Your changes save automatically.
    </span>

    <button class="btn-danger" id="clearButton">
      Clear all entries
    </button>
  </div>

  <div class="instructions">
    <strong>How to use this page</strong><br>
    1. Enter the recipient's name, address and mobile number.<br>
    2. Select Seep, Organizer or Gajraj from the gift dropdown.<br>
    3. Use the search box or filters to find specific recipients.<br>
    4. Select <strong>Export CSV</strong> to save a spreadsheet of the list.<br>
    5. Your entries are saved in this browser automatically. No account is required.
  </div>

</main>

<script>
  const STORAGE_KEY = "giftRecipientManager_v1";
  const GIFT_TYPES = ["Seep", "Organizer", "Gajraj"];
  const TOTAL = 70;

  const list = document.getElementById("recipientList");
  const searchInput = document.getElementById("searchInput");
  const giftFilter = document.getElementById("giftFilter");
  const emptyState = document.getElementById("emptyState");
  const saveStatus = document.getElementById("saveStatus");

  let recipients = loadRecipients();

  function createEmptyRecipient(id) {
    return {
      id,
      name: "",
      address: "",
      mobile: "",
      gift: ""
    };
  }

  function loadRecipients() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);

      if (saved) {
        const parsed = JSON.parse(saved);

        if (Array.isArray(parsed)) {
          return Array.from({ length: TOTAL }, (_, index) => {
            const id = index + 1;
            const old = parsed.find(item => item.id === id) || {};

            return {
              id,
              name: typeof old.name === "string" ? old.name : "",
              address: typeof old.address === "string" ? old.address : "",
              mobile: typeof old.mobile === "string" ? old.mobile : "",
              gift: GIFT_TYPES.includes(old.gift) ? old.gift : ""
            };
          });
        }
      }
    } catch (error) {
      console.error("Could not load saved entries:", error);
    }

    return Array.from(
      { length: TOTAL },
      (_, index) => createEmptyRecipient(index + 1)
    );
  }

  function saveRecipients() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(recipients));
      saveStatus.textContent = "✓ All changes saved in this browser.";
    } catch (error) {
      saveStatus.textContent =
        "Saving failed. Please export your data as a backup.";
    }
  }

  function createInput(id, field, placeholder, type = "text") {
    const input = document.createElement("input");

    input.type = type;
    input.value = recipients[id - 1][field];
    input.placeholder = placeholder;
    input.setAttribute("aria-label", `${placeholder}, recipient ${id}`);

    if (field === "mobile") {
      input.autocomplete = "off";
      input.inputMode = "tel";
      input.maxLength = 25;
    }

    if (field === "name") {
      input.autocomplete = "off";
    }

    if (field === "address") {
      input.className = "address-input";
    }

    input.addEventListener("input", () => {
      recipients[id - 1][field] = input.value;
      saveRecipients();
      updateStats();
      applyFilters();
    });

    return input;
  }

  function createGiftSelect(id) {
    const select = document.createElement("select");
    select.className = "gift-select";
    select.setAttribute("aria-label", `Gift type, recipient ${id}`);

    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Choose a gift";
    select.appendChild(placeholder);

    GIFT_TYPES.forEach(gift => {
      const option = document.createElement("option");
      option.value = gift;
      option.textContent = gift;
      select.appendChild(option);
    });

    select.value = recipients[id - 1].gift;

    select.addEventListener("change", () => {
      recipients[id - 1].gift = select.value;
      saveRecipients();
      updateStats();
      applyFilters();
    });

    return select;
  }

  function renderRows() {
    const fragment = document.createDocumentFragment();

    recipients.forEach(person => {
      const row = document.createElement("tr");
      row.dataset.id = person.id;

      const numberCell = document.createElement("td");
      numberCell.textContent = person.id;

      const nameCell = document.createElement("td");
      nameCell.appendChild(
        createInput(person.id, "name", "Full name")
      );

      const addressCell = document.createElement("td");
      addressCell.appendChild(
        createInput(person.id, "address", "Full address")
      );

      const mobileCell = document.createElement("td");
      mobileCell.appendChild(
        createInput(person.id, "mobile", "Mobile number", "tel")
      );

      const giftCell = document.createElement("td");
      giftCell.appendChild(createGiftSelect(person.id));

      row.append(
        numberCell,
        nameCell,
        addressCell,
        mobileCell,
        giftCell
      );

      fragment.appendChild(row);
    });

    list.replaceChildren(fragment);
    updateStats();
    applyFilters();
  }

  function updateStats() {
    const completed = recipients.filter(person =>
      person.name.trim() &&
      person.address.trim() &&
      person.mobile.trim()
    ).length;

    const assigned = recipients.filter(person =>
      GIFT_TYPES.includes(person.gift)
    ).length;

    document.getElementById("totalCount").textContent = TOTAL;
    document.getElementById("completedCount").textContent =
      `${completed} / ${TOTAL}`;
    document.getElementById("giftCount").textContent =
      `${assigned} / ${TOTAL}`;
  }

  function applyFilters() {
    const query = searchInput.value.trim().toLowerCase();
    const filter = giftFilter.value;
    let visible = 0;

    recipients.forEach(person => {
      const row = list.querySelector(
        `tr[data-id="${person.id}"]`
      );

      if (!row) return;

      const searchable = [
        person.name,
        person.address,
        person.mobile
      ].join(" ").toLowerCase();

      const matchesSearch = searchable.includes(query);

      const matchesGift =
        filter === "all" ||
        (filter === "unassigned" && !person.gift) ||
        person.gift === filter;

      const show = matchesSearch && matchesGift;

      row.hidden = !show;

      if (show) visible++;
    });

    emptyState.style.display = visible === 0 ? "block" : "none";
  }

  function exportCSV() {
    const headers = [
      "No.",
      "Name",
      "Address",
      "Mobile Number",
      "Type of Gift"
    ];

    function escapeCSV(value) {
      let text = String(value ?? "");

      // Prevent spreadsheet formula injection from text fields.
      if (/^[\s]*[=+\-@\t\r]/.test(text)) {
        text = "'" + text;
      }

      return '"' + text.replace(/"/g, '""') + '"';
    }

    const rows = recipients.map(person => [
      person.id,
      person.name,
      person.address,
      person.mobile,
      person.gift
    ]);

    const csv = [headers, ...rows]
      .map(row => row.map(escapeCSV).join(","))
      .join("\r\n");

    // UTF-8 BOM helps Excel display text correctly.
    const blob = new Blob(["\uFEFF" + csv], {
      type: "text/csv;charset=utf-8;"
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "gift-recipients.csv";
    link.click();

    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  searchInput.addEventListener("input", applyFilters);
  giftFilter.addEventListener("change", applyFilters);

  document.getElementById("resetFilter").addEventListener("click", () => {
    searchInput.value = "";
    giftFilter.value = "all";
    applyFilters();
  });

  document.getElementById("exportButton").addEventListener(
    "click",
    exportCSV
  );

  document.getElementById("clearButton").addEventListener("click", () => {
    const confirmed = confirm(
      "Are you sure you want to clear all 70 entries? This cannot be undone."
    );

    if (!confirmed) return;

    recipients = Array.from(
      { length: TOTAL },
      (_, index) => createEmptyRecipient(index + 1)
    );

    saveRecipients();
    renderRows();
  });

  renderRows();
</script>

</body>
</html>
